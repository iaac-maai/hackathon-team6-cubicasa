{
  "name": "hackathon-team6-cubicasa-app",
  "private": true,
  "type": "module",
  "description": "Team 6: a password-protected React app on Cloudflare Workers that sends a floor plan to our model server, shows the five most similar plans, what the network computed, and stores each search in D1 and R2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc -b",
    "db:local": "wrangler d1 execute hackathon-team6-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute hackathon-team6-db --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute hackathon-team6-db --local --file=migrate_add_model.sql",
    "db:migrate:remote": "wrangler d1 execute hackathon-team6-db --remote --file=migrate_add_model.sql",
    "db:embedding:local": "wrangler d1 execute hackathon-team6-db --local --file=migrate_add_embedding.sql",
    "db:embedding:remote": "wrangler d1 execute hackathon-team6-db --remote --file=migrate_add_embedding.sql",
    "db:accounts:local": "wrangler d1 execute hackathon-team6-db --local --file=accounts.sql",
    "db:accounts:remote": "wrangler d1 execute hackathon-team6-db --remote --file=accounts.sql",
    "db:user:local": "wrangler d1 execute hackathon-team6-db --local --file=migrate_add_user.sql",
    "db:user:remote": "wrangler d1 execute hackathon-team6-db --remote --file=migrate_add_user.sql"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "better-auth": "^1.7.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.156.1"
  }
}
